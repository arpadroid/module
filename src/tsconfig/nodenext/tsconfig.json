{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "esModuleInterop": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "skipLibCheck": false,
        "strict": true,
        "target": "ESNext",
        "types": ["node"],
        "useDefineForClassFields": false,
        "strictPropertyInitialization": false,
        "preserveSymlinks": true,
        "jsx": "react",
        "paths": {
            "@jest/globals": ["../../../node_modules/@jest/globals/build/index.d.ts"],
            "yargs": ["../../../node_modules/@types/yargs/index.d.ts"],
            "yargs/helpers": ["../../../node_modules/@types/yargs/helpers.d.ts"]
        }
    },
    "include": ["src/index.js", "src/**/*"],
    "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
