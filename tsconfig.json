{
    "extends": "./src/tsconfig/nodenext/tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "outDir": "./.tmp/.types",
        "rootDir": "./src",
        "skipLibCheck": false,
        "typeRoots": ["./node_modules/@types", "./node_modules/@arpadroid/module/node_modules/@types"],
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "./dist/@types", "./src/install/appConfig/jest.config.mjs"]
}
